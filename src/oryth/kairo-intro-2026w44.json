    "en": {
      "title": "KAIRO, a film camera app from OVJECT",
      "body": "A film camera app for iOS. Halation and bloom rebuilt from real light, HDR glow on lights, black-and-white contrast.",
      "cta_label": "Learn more",
      "secondary_label": "Not now"
    },
